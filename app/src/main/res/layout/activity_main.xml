<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="#f0f0f0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Главное меню"
        android:textSize="24sp"
        android:textStyle="bold" />


    <Button
        android:id="@+id/btnGoToCalculator"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Калькулятор"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnGoToPlayer"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Медиа-плеер"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGoToLocation"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Локация"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGoToTelephony"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Телефония"
        android:textSize="18sp" />

</LinearLayout>